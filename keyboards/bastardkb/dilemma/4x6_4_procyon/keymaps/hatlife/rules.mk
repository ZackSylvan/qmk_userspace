VIA_ENABLE = no
SPLIT_WATCHDOG_ENABLE = yes
# Native touchpad via the digitizer; the relative-mouse fallback is OFF so it can't fight the
# smooth absolute cursor. MOUSEKEY stays on purely as a buttons-only "virtual mouse" for the
# J/K/L clicks on the _MSE layer (no movement keys are mapped, so it never moves the cursor).
DIGITIZER_ENABLE = yes
POINTING_DEVICE_ENABLE = no
MOUSEKEY_ENABLE = yes
